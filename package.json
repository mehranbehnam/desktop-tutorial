{
  "name": "lilika",
  "version": "0.1.0",
  "private": true,
  "description": "LiLika — a standalone messenger client built on the Telegram (MTProto) platform",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:host": "vite --host",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc -b",
    "doctor": "node tools/doctor.mjs",
    "harness": "node tools/ui-harness.mjs",
    "android:sync": "npm run build && npx cap sync android",
    "android:open": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.9",
    "@capacitor/core": "^7.6.9",
    "big-integer": "^1.6.52",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "telegram": "^2.26.22",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.9",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "playwright": "^1.63.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vite-plugin-node-polyfills": "^0.24.0"
  }
}
