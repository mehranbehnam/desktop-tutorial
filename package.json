{
  "name": "lilika",
  "version": "0.1.0",
  "private": true,
  "description": "LiLika — a standalone messenger client built on the Telegram (MTProto) platform",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly false --pretty",
    "lint": "tsc -b"
  },
  "dependencies": {
    "big-integer": "^1.6.52",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "telegram": "^2.26.22",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vite-plugin-node-polyfills": "^0.24.0"
  }
}
